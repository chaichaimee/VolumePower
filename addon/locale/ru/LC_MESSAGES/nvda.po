#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "&Предупреждать, если устройство воспроизведения отключено или недоступно"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "&Количество повторных попыток (0 - бесконечно):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "&Предотвращать автоматический переход Windows в спящий режим"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "&Повторять попытки инициализации драйвера речевого синтезатора"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "Включить звук для &всех устройств воспроизведения, а не только по умолчанию"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "Звук выключен"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "Оба уха: {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "Отменено"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "Не удалось получить привилегию завершения работы"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "Уменьшить громкость NVDA на 5%"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "Громкость уха выключена"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "Ошибка: не удалось изменить громкость NVDA"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "Ошибка: нет доступного синтезатора"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "Ошибка ExitWindowsEx: {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "Не удалось изменить громкость уха"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "Увеличить громкость NVDA на 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "Увеличить громкость, если она &ниже:"

#: addonCore.py:186
msgid "Left"
msgstr "Слева"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "Открыть режим громкости уха и объявить выбранное ухо: стрелки влево и вправо выбирают ухо, стрелки вверх и вниз изменяют его на 5, Enter делает оба уха равными, Escape закрывает. Любая другая клавиша также закрывает режим"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "Воспроизводить &звук при успешном включении аудио"

#: addonCore.py:227
#: addonCore.py:238
msgid "Restart"
msgstr "Перезагрузка"

#: addonCore.py:186
msgid "Right"
msgstr "Справа"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "Выберите начальные настройки звуковой системы при запуске NVDA:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "Задать &пользовательский уровень громкости:"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "Показывать диалог &подтверждения с обратным отсчётом перед выключением или перезагрузкой"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "Завершение работы системы (одно нажатие) или перезагрузка (двойное нажатие)"

#: addonCore.py:227
#: addonCore.py:238
msgid "Shutdown"
msgstr "Завершение работы"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "Переключиться на &устройство вывода звука по умолчанию"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "Устройство вывода не является стереофоническим"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "Предупреждение: ранее включённое звуковое устройство сейчас недоступно или отключено. Проверьте настройки звука."

#: countdownDialog.py:49
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{action} через {seconds} сек. Нажмите любую клавишу для отмены."

#: addonCore.py:192
msgid "{ear} {level}"
msgstr "{ear}: {level}"

#: addonCore.py:188
msgid "{ear} {level}, maximum"
msgstr "{ear}: {level}, максимум"

#: addonCore.py:190
msgid "{ear} {level}, minimum"
msgstr "{ear}: {level}, минимум"

#: countdownDialog.py:79
msgid "{seconds}..."
msgstr "{seconds}..."

#: addonCore.py:101
msgid "{volume}%"
msgstr "{volume}%"