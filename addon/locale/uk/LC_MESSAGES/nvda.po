#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "&Сповіщати, якщо пристрій відтворення вимкнено або він недоступний"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "&Кількість повторних спроб (0 - нескінченно):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "За&побігати автоматичному переходу Windows у сплячий режим"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "Пов&торювати спроби ініціалізації драйвера мовного синтезатора"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "Увімкнути звук для &всех пристроїв відтворення, а не лише за замовчуванням"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "Звук вимкнено"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "Обидва вуха: {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "Скасовано"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "Не вдалося отримати привілеї завершення роботи"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "Зменшити гучність NVDA на 5%"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "Гучність вуха вимкнено"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "Помилка: Не вдалося змінити гучність NVDA"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "Помилка: Немає доступного синтезатора"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "Помилка ExitWindowsEx: {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "Не вдалося змінити гучність вуха"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "Збільшити гучність NVDA на 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "Збільшити гучність, якщо вона &нижча за:"

#: addonCore.py:186
msgid "Left"
msgstr "Ліворуч"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "Відкрити шар гучності вуха та оголосити вибране вухо: стрілки вліво та вправо вибирають вухо, стрілки вгору та вниз змінюють його на 5, Enter робить обидва вуха рівними, Escape закриває. Будь-яка інша клавіша також закриває шар"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "Відтворювати &звук при успішному увімкненні аудіо"

#: addonCore.py:227
#: addonCore.py:237
msgid "Restart"
msgstr "Перезавантаження"

#: addonCore.py:186
msgid "Right"
msgstr "Праворуч"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "Оберіть початкові налаштування звукової системи при запуску NVDA:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "Встановити &власний уровень гучності:"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "Показувати діалог &підтвердження зі зворотним відліком перед вимкненням або перезавантаженням"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "Завершення роботи системи (одне натискання) або перезавантаження (подвійне)"

#: addonCore.py:227
#: addonCore.py:237
msgid "Shutdown"
msgstr "Завершення роботи"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "Переключитися на &пристрій виведення аудіо за замовчуванням"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "Пристрій виведення не є стерео"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "Попередження: раніше увімкнений звуковий пристрій зараз недоступний або вимкнений. Будь ласка, перевірте налаштування звуку."

#: countdownDialog.py:42
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{action} через {seconds} сек. Натисніть будь-яку клавішу для скасування."

#: addonCore.py:192
msgid "{ear} {level}"
msgstr "{ear}: {level}"

#: addonCore.py:188
msgid "{ear} {level}, maximum"
msgstr "{ear}: {level}, максимум"

#: addonCore.py:190
msgid "{ear} {level}, minimum"
msgstr "{ear}: {level}, мінімум"

#: countdownDialog.py:63
msgid "{seconds}..."
msgstr "{seconds}..."

#: addonCore.py:101
msgid "{volume}%"
msgstr "{volume}%"