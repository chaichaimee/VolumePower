#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "&Avisarme si un dispositivo de reproducción se deshabilita o no está disponible"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "&Número de reintentos (0 - infinito):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "&Evitar que Windows entre en suspensión automáticamente"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "&Repetir intentos para inicializar el controlador del sintetizador de voz"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "Dessilenciar &todos los dispositivos de reproducción, no solo el predeterminado"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "Audio silenciado"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "Ambos oídos {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "Cancelado"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "No se puede obtener el privilegio de apagado"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "Disminuir el volumen de NVDA un 5%"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "Volumen del oído cerrado"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "Error: fallo al cambiar el volumen de NVDA"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "Error: no hay sintetizador disponible"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx falló con el error {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "No se pudo cambiar el volumen del oído"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "Aumentar el volumen de NVDA un 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "Aumentar el volumen si es &inferior a:"

#: addonCore.py:186
msgid "Left"
msgstr "Izquierda"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "Abre la capa de volumen del oído y anuncia el oído seleccionado: las flechas izquierda y derecha seleccionan el oído, las flechas arriba y abajo lo cambian en 5, Intro iguala ambos oídos, Escape la cierra. Cualquier otra tecla también cierra la capa"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "Reproducir &sonido cuando el audio se haya activado correctamente"

#: addonCore.py:227
#: addonCore.py:238
msgid "Restart"
msgstr "Reiniciar"

#: addonCore.py:186
msgid "Right"
msgstr "Derecha"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "Selecciona la configuración inicial del sistema de sonido al iniciar NVDA:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "Establecer nivel de volumen &personalizado:"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "Mostrar diálogo de &confirmación con cuenta atrás antes de apagar o reiniciar"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "Apagar el sistema (un toque) o reiniciarlo (doble toque)"

#: addonCore.py:227
#: addonCore.py:238
msgid "Shutdown"
msgstr "Apagar"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "Cambiar al &dispositivo de salida de audio predeterminado"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "El dispositivo de salida no es estéreo"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "Advertencia: un dispositivo de sonido previamente habilitado ya no está disponible o está deshabilitado. Comprueba la configuración de sonido."

#: countdownDialog.py:49
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{action} en {seconds}. Pulsa cualquier tecla para cancelar."

