#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "M'&alerter si un périphérique de lecture devient désactivé ou indisponible"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "&Nombre de tentatives (0 - infini) :"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "Empêc&her Windows de passer automatiquement en veille"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "Répéte&r les tentatives d'initialisation du pilote du synthétiseur vocal"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "Réactiver le son de &tous les périphériques de lecture, pas seulement celui par défaut"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "Audio muet"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "Les deux oreilles {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "Annulé"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "Impossible d'obtenir le privilège de fermeture"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "Diminuer le volume de NVDA de 5 %"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "Volume de l'oreille fermé"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "Erreur : Échec de la modification du volume de NVDA"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "Erreur : Aucun synthétiseur disponible"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx a échoué avec l'erreur {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "Échec de la modification du volume de l'oreille"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "Augmenter le volume de NVDA de 5 %"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "Augmenter le volume s'il est &inférieur à :"

#: addonCore.py:186
msgid "Left"
msgstr "Gauche"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "Ouvre la couche de volume des oreilles et annonce l'oreille sélectionnée : Les flèches gauche et droite sélectionnent l'oreille, les flèches haut et bas la modifient de 5, Entrée rend les deux oreilles égales, Échap ferme. N'importe quelle autre touche ferme également la couche"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "Jouer un &son lorsque l'audio a été activé avec succès"

#: addonCore.py:227
#: addonCore.py:238
msgid "Restart"
msgstr "Redémarrer"

#: addonCore.py:186
msgid "Right"
msgstr "Droite"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "Sélectionnez les paramètres initiaux du système sonore à appliquer au démarrage de NVDA :"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "Définir un niveau de volume &personnalisé :"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "Afficher le dialogue de &confirmation avec compte à rebours avant l'arrêt ou le redémarrage"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "Éteindre le système (simple appui) ou le redémarrer (double appui)"

#: addonCore.py:227
#: addonCore.py:238
msgid "Shutdown"
msgstr "Éteindre"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "Basculer vers le périphérique de sortie audio par &défaut"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "Le périphérique de sortie n'est pas stéréo"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "Avertissement : un périphérique audio précédemment activé est désormais indisponible ou désactivé. Veuillez vérifier les paramètres de son."

#: countdownDialog.py:49
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{action} dans {seconds}. Appuyez sur n'importe quelle touche pour annuler."

#: addonCore.py:192
msgid "{ear} {level}"
msgstr "{ear} {level}"

#: addonCore.py:188
# keep-identical
msgid "{ear} {level}, maximum"
msgstr "{ear} {level}, maximum"

#: addonCore.py:190
# keep-identical
msgid "{ear} {level}, minimum"
msgstr "{ear} {level}, minimum"

#: countdownDialog.py:79
msgid "{seconds}..."
msgstr "{seconds}..."

#: addonCore.py:101
msgid "{volume}%"
msgstr "{volume} %"