#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "当播放设备被禁用或不可用时提醒我(&A)"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "重试次数（0 表示无限）(&N):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "阻止 Windows 自动进入睡眠状态(&P)"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "重复尝试初始化语音合成器驱动程序(&R)"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "取消所有播放设备的静音，而不只是默认设备(&U)"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "音频已静音"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "双耳 {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "已取消"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "无法获取关机权限"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "降低 NVDA 音量 5%"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "耳朵音量已关闭"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "错误：无法更改 NVDA 音量"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "错误：没有可用的语音合成器"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx 失败，错误代码：{error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "更改耳朵音量失败"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "提高 NVDA 音量 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "如果音量低于此值则提高音量(&L):"

#: addonCore.py:186
msgid "Left"
msgstr "左"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "打开耳朵音量层并播报所选耳朵：左右方向键选择耳朵，上下方向键以 5 为步长调整，回车键使双耳平衡，Esc 键关闭。任何其他按键也会关闭此层"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "成功开启音频时播放声音(&S)"

#: addonCore.py:227
#: addonCore.py:238
msgid "Restart"
msgstr "重新启动"

#: addonCore.py:186
msgid "Right"
msgstr "右"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "选择 NVDA 启动时应用的初始声音系统设置："

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "设置自定义音量级别(&C):"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "在关机或重启前显示倒计时确认对话框(&C)"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "关闭系统（单击）或重新启动（双击）"

#: addonCore.py:227
#: addonCore.py:238
msgid "Shutdown"
msgstr "关机"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "切换到默认音频输出设备(&D)"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "输出设备不是立体声"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "警告：之前启用的音频设备现已不可用或已禁用。请检查声音设置。"

#: countdownDialog.py:49
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "将在 {seconds} 秒内{action}。按任意键取消。"

#: addonCore.py:192
msgid "{ear} {level}"
msgstr "{ear} {level}"

#: addonCore.py:188
msgid "{ear} {level}, maximum"
msgstr "{ear} {level}，最大"

#: addonCore.py:190
msgid "{ear} {level}, minimum"
msgstr "{ear} {level}，最小"

#: countdownDialog.py:79
msgid "{seconds}..."
msgstr "{seconds}..."

#: addonCore.py:101
msgid "{volume}%"
msgstr "{volume}%"