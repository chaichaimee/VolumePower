#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "Ben&achrichtigen, wenn ein Wiedergabegerät deaktiviert oder nicht verfügbar wird"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "Anzahl der Wiede&rholungen (0 - unendlich):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "Automatischen &Energiesparmodus von Windows verhindern"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "Versuche zur Initialisie&rung des Sprachausgabe-Treibers wiederholen"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "Stummschaltung für &alle Wiedergabegeräte aufheben, nicht nur für das Standardgerät"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "Ton ist stummgeschaltet"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "Beide Ohren {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "Abgebrochen"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "Berechtigung zum Herunterfahren kann nicht abgerufen werden"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "NVDA-Lautstärke um 5% verringern"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "Ohrenlautstärke geschlossen"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "Fehler: NVDA-Lautstärke konnte nicht geändert werden"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "Fehler: Keine Sprachausgabe verfügbar"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx fehlgeschlagen mit Fehler {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "Fehler beim Ändern der Ohrenlautstärke"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "NVDA-Lautstärke um 5% erhöhen"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "Lautstärke erhöhen, wenn sie &niedriger ist als:"

#: addonCore.py:186
msgid "Left"
msgstr "Links"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "Öffnet die Ohrenlautstärke-Ebene und gibt das ausgewählte Ohr aus: Mit den Pfeiltasten Links und Rechts wird das Ohr ausgewählt, mit Oben und Unten der Wert um 5 geändert, die Eingabetaste gleicht beide Ohren an, Escape schließt die Ebene. Jede andere Taste schließt die Ebene ebenfalls"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "&Sound abspielen, wenn das Audio erfolgreich aktiviert wurde"

#: addonCore.py:227
#: addonCore.py:238
msgid "Restart"
msgstr "Neu starten"

#: addonCore.py:186
msgid "Right"
msgstr "Rechts"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "Wählen Sie die initialen Soundsystem-Einstellungen aus, die beim Start von NVDA festgelegt werden:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "&Benutzerdefinierte Lautstärke festlegen:"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "Bestätigungsdialog mit &Countdown vor dem Herunterfahren oder Neustarten anzeigen"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "System herunterfahren (einmal drücken) oder neu starten (doppelt drücken)"

#: addonCore.py:227
#: addonCore.py:238
msgid "Shutdown"
msgstr "Herunterfahren"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "Zum Standard-Audioausgabe&gerät wechseln"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "Das Ausgabegerät ist nicht in Stereo"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "Warnung: Ein zuvor aktiviertes Soundgerät ist jetzt nicht verfügbar oder deaktiviert. Bitte überprüfen Sie die Sound-Einstellungen."

#: countdownDialog.py:49
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{action} in {seconds}. Drücken Sie eine beliebige Taste zum Abbrechen."

#: addonCore.py:192
msgid "{ear} {level}"
msgstr "{ear} {level}"

#: addonCore.py:188
msgid "{ear} {level}, maximum"
msgstr "{ear} {level}, Maximum"

#: addonCore.py:190
msgid "{ear} {level}, minimum"
msgstr "{ear} {level}, Minimum"

#: countdownDialog.py:79
msgid "{seconds}..."
msgstr "{seconds}..."

#: addonCore.py:101
msgid "{volume}%"
msgstr "{volume}%"