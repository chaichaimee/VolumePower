#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "&Alertar-me se um dispositivo de reprodução for desativado ou ficar indisponível"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "&Número de tentativas (0 - infinitamente):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "&Impedir que o Windows entre em suspensão automaticamente"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "&Repetir tentativas de inicializar o driver do sintetizador de voz"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "Ativar o som de &todos os dispositivos de reprodução, não apenas o padrão"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "Áudio sem som"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "Ambos os ouvidos {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "Cancelado"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "Não é possível obter privilégio para desligar"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "Diminuir o volume do NVDA em 5%"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "Volume do ouvido fechado"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "Erro: falha ao alterar o volume do NVDA"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "Erro: nenhum sintetizador disponível"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx falhou com o erro {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "Falha ao alterar o volume do ouvido"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "Aumentar o volume do NVDA em 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "Aumentar o volume se estiver &abaixo de:"

#: addonCore.py:186
msgid "Left"
msgstr "Esquerda"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "Abre a camada de volume do ouvido e anuncia o ouvido selecionado: As setas Esquerda e Direita selecionam o ouvido, as setas Cima e Baixo alteram em 5, Enter iguala ambos os ouvidos, Esc fecha. Qualquer outra tecla também fecha a camada"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "Tocar &som quando o áudio for ativado com sucesso"

#: addonCore.py:227
#: addonCore.py:237
msgid "Restart"
msgstr "Reiniciar"

#: addonCore.py:186
msgid "Right"
msgstr "Direita"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "Selecione as configurações iniciais do sistema de som que serão aplicadas ao iniciar o NVDA:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "Definir nível de volume &personalizado:"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "Exibir diálogo de &confirmação com contagem regressiva antes de desligar ou reiniciar"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "Desligar o sistema (toque simples) ou reiniciar (toque duplo)"

#: addonCore.py:227
#: addonCore.py:237
msgid "Shutdown"
msgstr "Desligar"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "Alternar para o &dispositivo de saída de áudio padrão"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "O dispositivo de saída não é estéreo"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "Aviso: um dispositivo de som ativado anteriormente está indisponível ou desativado. Verifique as configurações de som."

#: countdownDialog.py:42
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{action} em {seconds}. Pressione qualquer tecla para cancelar."

#: addonCore.py:192
msgid "{ear} {level}"
msgstr "{ear} {level}"

#: addonCore.py:188
msgid "{ear} {level}, maximum"
msgstr "{ear} {level}, máximo"

#: addonCore.py:190
msgid "{ear} {level}, minimum"
msgstr "{ear} {level}, mínimo"

#: countdownDialog.py:63
msgid "{seconds}..."
msgstr "{seconds}..."

#: addonCore.py:101
msgid "{volume}%"
msgstr "{volume}%"