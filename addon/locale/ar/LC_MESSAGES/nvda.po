#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "&تنبيهي إذا أصبح جهاز التشغيل معطلاً أو غير متاح"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "&عدد المحاولات (0 - بلا نهاية):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "&منع ويندوز من الدخول في وضع السكون تلقائياً"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "&تكرار محاولات تهيئة برنامج تشغيل آلة النطق"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "إلغاء &كتم جميع أجهزة التشغيل، وليس الجهاز الافتراضي فقط"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "الصوت مكتوم"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "الأذنان معاً {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "تم الإلغاء"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "تعذر الحصول على صلاحية إيقاف التشغيل"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "ทخفيض مستوى صوت NVDA بمقدار 5%"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "صوت الأذن مغلق"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "خطأ: فشล تغيير مستوى صوت NVDA"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "خطأ: لا يوجد آلة نطق متاحة"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "فشل ExitWindowsEx بالخطأ {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "فشل تغيير مستوى صوت الأذن"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "زيادة مستوى صوت NVDA بمقدار 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "&رفع مستوى الصوت إذا كان أقل من:"

#: addonCore.py:186
msgid "Left"
msgstr "اليسار"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "افتح طبقة مستوى صوت الأذن وانطق الأذن المحددة: سهمَا اليسار واليمين يحددان الأذن، وسهمَا الأعلى والأسفل يغيران المستوى بمقدار 5، ومفتاح الإدخال يجعل الأذنين متساويتين، ومفتاح الهروب يغلق الطبقة. أي مفتاح آخر يغلق الطبقة أيضاً"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "&تشغيل صوت عند تشغيل الصوت بنجاح"

#: addonCore.py:227
#: addonCore.py:238
msgid "Restart"
msgstr "إعادة التشغيل"

#: addonCore.py:186
msgid "Right"
msgstr "اليمين"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "حدد إعدادات نظام الصوت الأولية التي سيتم ضبطها عند بدء تشغيل NVDA:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "تحديد مستوى صوت &مخصص:"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "إظهار مربع &حوار تأكيد العد التنازلي قبل إيقاف التشغيل أو إعادة التشغيل"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "إيقاف تشغيل النظام (ضغط واحدة) أو إعادة تشغيله (ضغطتان)"

#: addonCore.py:227
#: addonCore.py:238
msgid "Shutdown"
msgstr "إيقاف التشغيل"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "التبديل إلى جهاز &إخراج الصوت الافتراضي"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "جهاز الإخراج ليس ستيريو"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "تحذير: جهاز الصوت الذي تم تمكينه سابقاً غير متاح أو معطل الآن. يرجى التحقق من إعدادات الصوت."

#: countdownDialog.py:49
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "سيتم {action} خلال {seconds}. اضغط على أي مفتاح للإلغاء."

#: addonCore.py:192
msgid "{ear} {level}"
msgstr "{ear} {level}"

#: addonCore.py:188
msgid "{ear} {level}, maximum"
msgstr "{ear} {level}، الحد الأقصى"

#: addonCore.py:190
msgid "{ear} {level}, minimum"
msgstr "{ear} {level}، الحد الأدنى"

#: countdownDialog.py:79
msgid "{seconds}..."
msgstr "{seconds}..."

