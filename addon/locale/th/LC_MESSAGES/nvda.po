#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "แจ้งเตือนเมื่ออุปกรณ์เล่นเสียงถูกปิดใช้งานหรือไม่พร้อมใช้งาน (&A)"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "จำนวนครั้งที่พยายามใหม่ (0 - ไม่จำกัด) (&N):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "ป้องกันไม่ให้ Windows เข้าสู่โหมดสลีปโดยอัตโนมัติ (&P)"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "พยายามเริ่มทำงานไดรเวอร์สังเคราะห์เสียงใหม่อีกครั้ง (&R)"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "เปิดเสียงอุปกรณ์เล่นเสียงทั้งหมด ไม่ใช่แค่อุปกรณ์เริ่มต้น (&U)"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "เสียงถูกปิดใช้งาน"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "ทั้งสองข้าง {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "ยกเลิกแล้ว"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "ไม่ได้รับสิทธิ์ในการปิดเครื่อง"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "ลดระดับเสียง NVDA 5%"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "ปิดเสียงหูข้างนี้"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "ข้อผิดพลาด: เปลี่ยนระดับเสียง NVDA ไม่สำเร็จ"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "ข้อผิดพลาด: ไม่มีโปรแกรมสังเคราะห์เสียงที่พร้อมใช้งาน"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx ล้มเหลวด้วยข้อผิดพลาด {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "ไม่สามารถเปลี่ยนระดับเสียงของหูได้"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "เพิ่มระดับเสียง NVDA 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "เพิ่มระดับเสียงหากต่ำกว่า (&L):"

#: addonCore.py:186
msgid "Left"
msgstr "ซ้าย"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "เปิดเลเยอร์ระดับเสียงและประกาศหูที่เลือก: ลูกศรซ้ายและขวาเลือกหู ลูกศรขึ้นและลงปรับระดับทีละ 5 Enter ทำให้เสียงทั้งสองข้างเท่ากัน Escape ปิด ปุ่มอื่นๆ ทั้งหมดก็จะปิดเลเยอร์เช่นกัน"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "เล่นเสียงเมื่อเปิดระบบเสียงสำเร็จแล้ว (&S)"

#: addonCore.py:227
#: addonCore.py:238
msgid "Restart"
msgstr "รีสตาร์ต"

#: addonCore.py:186
msgid "Right"
msgstr "ขวา"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "เลือกการตั้งค่าระบบเสียงเริ่มต้นที่จะใช้เมื่อ NVDA เริ่มทำงาน:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "กำหนดระดับเสียงที่ต้องการ (&C):"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "แสดงกล่องข้อความยืนยันนับถอยหลังก่อนปิดเครื่องหรือรีสตาร์ต (&C)"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "ปิดระบบ (กดหนึ่งครั้ง) หรือรีสตาร์ตระบบ (กดสองครั้ง)"

#: addonCore.py:227
#: addonCore.py:238
msgid "Shutdown"
msgstr "ปิดเครื่อง"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "สลับไปใช้อุปกรณ์ส่งออกเสียงเริ่มต้น (&D)"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "อุปกรณ์ส่งออกไม่ใช่เสียงสเตอริโอ"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "คำเตือน: อุปกรณ์เสียงที่เคยเปิดใช้งานก่อนหน้านี้ไม่พร้อมใช้งานหรือถูกปิดใช้งานอยู่ โปรดตรวจสอบการตั้งค่าเสียง"

#: countdownDialog.py:49
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "จะ{action}ในอีก {seconds} วินาที กดคีย์ใดก็ได้เพื่อยกเลิก"

#: addonCore.py:192
msgid "{ear} {level}"
msgstr "{ear} {level}"

#: addonCore.py:188
msgid "{ear} {level}, maximum"
msgstr "{ear} {level}, สูงสุด"

#: addonCore.py:190
msgid "{ear} {level}, minimum"
msgstr "{ear} {level}, ต่ำสุด"

#: countdownDialog.py:79
msgid "{seconds}..."
msgstr "{seconds}..."

#: addonCore.py:101
msgid "{volume}%"
msgstr "{volume}%"