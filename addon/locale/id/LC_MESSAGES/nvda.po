#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "&Beri tahu saya jika perangkat pemutaran dinonaktifkan atau tidak tersedia"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "Jumlah perco&baan ulang (0 - tanpa batas):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "Ce&gah Windows masuk ke mode tidur secara otomatis"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "&Ulangi upaya untuk menginisialisasi driver penyuara suara"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "Buka suar&a semua perangkat pemutaran, bukan hanya perangkat bawaan"

#: addonCore.py:174
msgid "Audio is muted"
msgstr "Audio dimatikan"

#: addonCore.py:181
msgid "Both ears {level}"
msgstr "Kedua telinga {level}"

#: addonCore.py:232
msgid "Cancelled"
msgstr "Dibatalkan"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "Tidak dapat memperoleh hak akses untuk mematikan"

#: addonCore.py:86
msgid "Decrease NVDA volume 5%"
msgstr "Kurangi volume NVDA sebesar 5%"

#: addonCore.py:145
msgid "Ear volume closed"
msgstr "Volume telinga ditutup"

#: addonCore.py:104
msgid "Error: Failed to change NVDA volume"
msgstr "Kesalahan: Gagal mengubah volume NVDA"

#: addonCore.py:94
msgid "Error: No synthesizer available"
msgstr "Kesalahan: Tidak ada penyuara suara yang tersedia"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx gagal dengan kesalahan {error}"

#: addonCore.py:178
msgid "Failed to change ear volume"
msgstr "Gagal mengubah volume telinga"

#: addonCore.py:79
msgid "Increase NVDA volume 5%"
msgstr "Tingkatkan volume NVDA sebesar 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "Tingkatkan volume jika lebih &rendah dari:"

#: addonCore.py:186
msgid "Left"
msgstr "Kiri"

#: addonCore.py:119
msgid "Open the ear volume layer and announce the selected ear: Left and Right arrows select the ear, Up and Down arrows change it by 5, Enter makes both ears equal, Escape closes. Any other key also closes the layer"
msgstr "Buka lapisan volume telinga dan umumkan telinga yang dipilih: Panah Kiri dan Kanan memilih telinga, Panah Atas dan Bawah mengubahnya sebesar 5, Enter menyamakan kedua telinga, Escape menutup. Tombol lain juga menutup lapisan"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "Putar &suara saat audio berhasil diaktifkan"

#: addonCore.py:227
#: addonCore.py:237
msgid "Restart"
msgstr "Mulai Ulang"

#: addonCore.py:186
msgid "Right"
msgstr "Kanan"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "Pilih pengaturan sistem suara awal yang akan diterapkan saat NVDA dimulai:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "Atur tingkat volume &kustom:"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "Tampilkan dialog kon&firmasi hitung mundur sebelum mematikan atau memulai ulang"

#: addonCore.py:210
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "Matikan sistem (tekan sekali) atau mulai ulang (tekan dua kali)"

#: addonCore.py:227
#: addonCore.py:237
msgid "Shutdown"
msgstr "Matikan"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "Beralih ke &perangkat output audio bawaan"

#: addonCore.py:176
msgid "The output device is not stereo"
msgstr "Perangkat keluaran bukan stereo"

#: audioGuard.py:306
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "Peringatan: perangkat suara yang sebelumnya diaktifkan sekarang tidak tersedia atau dinonaktifkan. Silakan periksa pengaturan Suara."

#: countdownDialog.py:42
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{action} dalam {seconds}. Tekan tombol apa saja untuk membatalkan."

